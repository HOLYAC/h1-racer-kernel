{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HOLYAC/h1-racer-kernel/blob/main/schema/race-plan-v1.schema.json",
  "title": "H1 Racer RacePlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "tls",
    "copies",
    "prefix_base64",
    "suffix_base64"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 3,
      "description": "TCP endpoint in host:port form"
    },
    "server_name": {
      "type": "string",
      "minLength": 1
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "client_hello_hex": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]+$"
        },
        "insecure_skip_verify": {
          "type": "boolean",
          "default": false
        },
        "ca_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "profile",
              "client_hello_hex"
            ]
          }
        }
      ]
    },
    "copies": {
      "type": "integer",
      "minimum": 2,
      "maximum": 200
    },
    "prefix_base64": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "base64"
    },
    "suffix_base64": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "base64"
    },
    "connect_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000,
      "default": 5000
    },
    "io_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000,
      "default": 5000
    },
    "settle_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000,
      "default": 0
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608,
      "default": 524288
    }
  }
}
